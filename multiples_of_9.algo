step-1: start
step-2: print "How many 9 multiles you want? "
step-3: read Count
step-4: Counter = 1
step-5: print "The first " + Count + " multiples of 9 are 9 "
step-6: if ( Count = Counter )
	  goto step-11
step-7: Counter = Counter + 1
step-8: Multiple = 9 * Counter
step-9: print ".\n"
step-10: stop


