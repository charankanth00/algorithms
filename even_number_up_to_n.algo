step-1: start
step-2: print "up to which number you want to print even number? "
step-3: read Count
step-4: Counter = 0
step-5: print "The even number up to " + Count + " are " + Counter 
step-6: Counter = Counter + 2
step-7: if ( Counter <= Count )
	  print ", " + Counter
	  goto step-6
step-8: print ".\n"
step-9: stop
