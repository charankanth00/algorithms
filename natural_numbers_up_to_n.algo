step-1: start
step-2: print "How many natural numbers you want to print? "
step-3: read Count
step-4: print "The first " + Count + " natural numbers are "
step-5: Counter = 1
step-6: if ( Counter < Count )
	  print Counter + ", "
	  Counter = Counter + 1
	  goto step-6
step-7: print Counter + ".\n"
step-8: stop
