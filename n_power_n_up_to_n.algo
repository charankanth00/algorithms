step-1: start
step-2: print "up to which numbers you want to print N power N series?"
step-3: read GivenNum
step-4: Count = 1
step-5: print "The N power N series up to " + GivenNum + " is " + Count
step-6: Count = Count + 1
step-7: PowerTerm = Count
step-8: Count = 1
step-9: if ( PowerTerm > GivenNum )
          goto step-14
step-10: if ( Count = Counter )
           print ", " + PowerTerm
           goto step-6
step-11: PowerTerm = PowerTerm * Count
step-12: Counter = CCounter + 1
step-13: goto step-9
step-14 print ".\n"
step-15: stop
