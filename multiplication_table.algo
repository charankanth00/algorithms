step-1: start
step-2: print "which multiplication table you want to print? "
step-3: read Table_Number
step-4: print "The Multiplication table of " + Table_Number + " is\n"
step-5: Counter = 1
step-6: Multiple = Table_Number * Counter
step-7: print Table_Number + " * " + Counter + " = " + Multiple + "\n"
step-8: if ( Counter = 20 )
	  goto step-11
step-9: Counter = Counter + 1
step-10: goto step-6
step-11: stop
